---
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-6xl">
  <PageHead slot="head" title="Home" />

  <main class="min-h-screen py-10">
    <!-- Grid Bento Box -->
    <section class="grid gap-4 grid-cols-1 md:grid-cols-3 md:auto-rows-[minmax(220px,_auto)]">
      
      <!-- 1. Kotak Perkenalan Utama (Lebar 2 Kolom) -->
      <div class="rounded-3xl border bg-card p-8 md:col-span-2 flex flex-col justify-center">
        <p class="text-muted-foreground mb-2 text-sm font-mono">Hello! I'm <span class="text-primary font-bold">Nerr.</span></p>
        <h1 class="text-3xl font-bold tracking-tight md:text-5xl mb-4 leading-tight">
          I build web, mobile, and cybersecurity projects.
        </h1>
        <p class="text-muted-foreground max-w-lg">
          Informatics student interested in web development, mobile apps, machine learning, computer vision, and CTF cybersecurity.
        </p>
      </div>

      <!-- 2. Kotak Gambar/Karakter Memanjang (Tinggi 2 Baris) -->
      <!-- Ganti URL src img di bawah dengan gambar/gif yang kamu inginkan -->
      <div class="rounded-3xl border bg-card overflow-hidden relative md:col-span-1 md:row-span-2 min-h-[300px] md:min-h-full">
        <img 
          src="https://images.unsplash.com/photo-1528642474498-1af0c17fd8c3?q=80&w=1000&auto=format&fit=crop" 
          alt="Profile Nerr" 
          class="absolute inset-0 w-full h-full object-cover opacity-60 hover:opacity-100 transition-opacity duration-500" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-background/90 to-transparent pointer-events-none"></div>
      </div>

      <!-- 3. Kotak Terminal/Cybersecurity (Kiri Bawah) -->
      <div class="rounded-3xl border bg-card p-6 md:col-span-1 flex flex-col justify-center font-mono text-sm">
        <p class="text-primary mb-2">> root@nerr:~# whoami</p>
        <p class="text-muted-foreground">> Learning CTF & Web Sec</p>
        <p class="text-muted-foreground">> Building React Native Apps</p>
        <p class="text-green-500 mt-2 animate-pulse">_</p>
      </div>

      <!-- 4. Kotak Download CV (Tengah Bawah) -->
      <a href="/cv.pdf" class="rounded-3xl border bg-card p-6 transition hover:bg-muted md:col-span-1 flex flex-col items-center justify-center group text-center cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground mb-4 group-hover:text-primary transition-colors"><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10.4 12.6a2 2 0 1 1 3 3L8 21l-4 1 1-4Z"/><path d="M18 21v-8a2 2 0 0 0-2-2h-3.5"/></svg>
        <h3 class="text-lg font-semibold">Download my CV ↗</h3>
      </a>

      <!-- 5. Kotak Featured Project (Lebar 2 Kolom) -->
      <div class="rounded-3xl border bg-card p-6 md:col-span-2">
        <p class="text-sm text-muted-foreground mb-2">Featured project</p>
        <h3 class="text-2xl font-semibold mb-3">Cakelytics</h3>
        <p class="text-muted-foreground">
          Mobile app for cake business management with product stock, sales records, production, and damaged goods tracking.
        </p>
      </div>

      <!-- 6. Kotak Blog -->
      <a href="/blog" class="rounded-3xl border bg-card p-6 transition hover:bg-muted md:col-span-1 flex flex-col justify-between">
        <p class="text-sm text-muted-foreground">Read</p>
        <h3 class="mt-4 text-2xl font-semibold">Blog ↗</h3>
      </a>

      <!-- 7. Kotak Tech Stack (Lebar 2 Kolom) -->
      <div class="rounded-3xl border bg-card p-6 md:col-span-2">
        <p class="text-sm text-muted-foreground mb-4">Tech stack</p>
        <div class="flex flex-wrap gap-2">
          <span class="rounded-full border bg-background px-4 py-1 text-sm">Astro</span>
          <span class="rounded-full border bg-background px-4 py-1 text-sm">React Native</span>
          <span class="rounded-full border bg-background px-4 py-1 text-sm">Node.js</span>
          <span class="rounded-full border bg-background px-4 py-1 text-sm">Prisma</span>
          <span class="rounded-full border bg-background px-4 py-1 text-sm">Python</span>
          <span class="rounded-full border bg-background px-4 py-1 text-sm">CTF</span>
        </div>
      </div>

      <!-- 8. Kotak Projects -->
      <a href="/projects" class="rounded-3xl border bg-card p-6 transition hover:bg-muted md:col-span-1 flex flex-col justify-between">
        <p class="text-sm text-muted-foreground">Explore</p>
        <h3 class="mt-4 text-2xl font-semibold">Projects ↗</h3>
      </a>

    </section>
  </main>

    <script>
    const navigation = performance.getEntriesByType("navigation")[0];

  if (navigation?.type === "reload") {
    window.location.replace("/");
  }
  </script>

</Layout>