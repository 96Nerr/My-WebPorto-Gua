<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Nerr</title>

  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap"
    rel="stylesheet"
  />

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      height: 100%;
    }

    body {
      overflow: hidden;
      background: #222831;
      font-family: "JetBrains Mono", monospace;
    }

    /* =====================================================
       HOME PREVIEW
       ===================================================== */

    .home-preview {
      position: fixed;
      inset: 0;

      z-index: 5;

      background: #222831;

      opacity: 0;
      visibility: hidden;

      overflow: hidden;

      transition: opacity 0.3s ease;
    }

    .home-preview.active {
      opacity: 1;
      visibility: visible;
    }

    .home-preview iframe {
      width: 100%;
      height: 100%;

      border: none;
      display: block;
    }

    /* =====================================================
       REVEAL
       ===================================================== */

    .reveal {
      position: fixed;
      inset: 0;

      z-index: 1;

      background: #948979;

      opacity: 0;

      pointer-events: none;

      transition: opacity 0.3s ease;
    }

    .reveal.active {
      opacity: 1;
    }

    /* =====================================================
       CAT
       ===================================================== */

    .cat {
      position: absolute;

      left: 50%;
      top: 50%;

      width: 600px;

      transform: translate(-50%, -50%);

      opacity: 0;

      transition: opacity 0.3s ease;

      z-index: 2;
    }

    .reveal.active .cat {
      opacity: 0.95;
    }

    /* =====================================================
       GRID
       ===================================================== */

    .grid {
      position: fixed;
      inset: 0;

      z-index: 10;

      display: grid;

      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: repeat(6, 1fr);

      gap: 4px;

      padding: 4px;

      perspective: 1500px;
    }

    /* =====================================================
       CARD
       ===================================================== */

    .card {
      position: relative;

      width: 100%;
      height: 100%;

      perspective: 1000px;

      cursor: pointer;

      /* Transisi untuk efek menghilang saat card-hidden aktif */
      transition:
        opacity 0.17s ease var(--delay, 0s),
        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) var(--delay, 0s);
    }

    .card-inner {
      position: relative;

      width: 100%;
      height: 100%;

      transform-style: preserve-3d;

      transition:
        transform 0.55s
        cubic-bezier(0.16, 1, 0.3, 1);

      transition-delay: var(--delay, 0s);
    }

    /* =====================================================
       HOVER
       ===================================================== */

    .grid:not(.clicked)
    .card:hover
    .card-inner {
      transform: rotateX(180deg);
      transition-delay: 0s !important;
    }

    /* =====================================================
       CLICKED
       ===================================================== */

    .grid.clicked
    .card-inner {
      transform: rotateX(180deg);
    }

    /* =====================================================
       HOVER SAAT SUDAH CLICKED
       ===================================================== */

    .grid.clicked
    .card:hover
    .card-inner {

      transform: rotateX(0deg);

      transition-delay: 0s !important;
    }

    /* =====================================================
       CARD KELUAR (FLIP & FADE OUT)
       ===================================================== */

    .card.card-hidden {
      opacity: 0;
      transform: scale(0.7) rotateX(90deg);
      pointer-events: none;
    }

    /* =====================================================
       FRONT / BACK
       ===================================================== */

    .card-front,
    .card-back {

      position: absolute;

      inset: 0;

      border-radius: 8px;

      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }

    /* =====================================================
       FRONT
       ===================================================== */

    .card-front {

      background:
        linear-gradient(
          135deg,
          #222831,
          #393E46
        );

      border:
        1px solid
        rgba(148, 137, 121, 0.4);

      box-shadow:
        inset 0 0 25px
        rgba(148, 137, 121, 0.05);

      transition:
        border-color 0.3s ease,
        box-shadow 0.3s ease;
    }

    .card-front::before {

      content: "";

      position: absolute;

      inset: 0;

      background:
        linear-gradient(
          90deg,
          transparent 49%,
          rgba(223, 208, 184, 0.08) 50%,
          transparent 51%
        ),
        linear-gradient(
          0deg,
          transparent 49%,
          rgba(223, 208, 184, 0.08) 50%,
          transparent 51%
        );
    }

    /* =====================================================
       HOVER GLOW
       ===================================================== */

    .grid:not(.clicked)
    .card:hover
    .card-front,

    .grid.clicked
    .card:hover
    .card-front {

      border-color: #DFD0B8;

      box-shadow:
        0 0 20px
        rgba(223, 208, 184, 0.25),

        inset 0 0 25px
        rgba(223, 208, 184, 0.1);
    }

    /* =====================================================
       BACK
       ===================================================== */

    .card-back {

      transform: rotateX(180deg);

      background: #393E46;

      border:
        1px solid
        rgba(34, 40, 49, 0.65);

      box-shadow:
        inset 0 0 15px
        rgba(34, 40, 49, 0.2);
    }

    /* =====================================================
       BACK CLICKED
       ===================================================== */

    .grid.clicked
    .card-back {

      background:
        linear-gradient(
          135deg,
          #393E46,
          #222831
        );

      border-color:
        rgba(223, 208, 184, 0.25);

      box-shadow:
        inset 0 0 20px
        rgba(223, 208, 184, 0.08);
    }

    /* =====================================================
       PROFILE
       ===================================================== */

    .profile {

      position: fixed;

      left: 50%;
      top: 50%;

      width: 475px;

      padding: 38px 40px;

      transform:
        translate(-50%, -50%)
        translateY(25px)
        scale(0.92);

      background: #222831;

      border:
        1px solid
        rgba(148, 137, 121, 0.3);

      border-radius: 18px;

      box-shadow:
        0 25px 60px
        rgba(0, 0, 0, 0.5),

        0 0 30px
        rgba(34, 40, 49, 0.5);

      display: flex;

      flex-direction: column;

      align-items: center;

      opacity: 0;

      z-index: 30;

      pointer-events: none;

      transition:
        opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .profile.active {

      opacity: 1;

      transform:
        translate(-50%, -50%)
        translateY(0)
        scale(1);

      pointer-events: auto;
    }

    .profile.fade-out {

      opacity: 0;

      transform:
        translate(-50%, -50%)
        scale(0.92);

      pointer-events: none;
    }

    /* =====================================================
       PROFILE IMAGE
       ===================================================== */

    .profile-image {

      width: 88px;
      height: 88px;

      object-fit: cover;

      border-radius: 50%;

      border:
        2px solid #948979;

      box-shadow:
        0 0 10px
        rgba(148, 137, 121, 0.7),

        0 0 25px
        rgba(223, 208, 184, 0.2);

      margin-bottom: 18px;
    }

    /* =====================================================
       PROFILE TEXT
       ===================================================== */

    .profile h1 {

      color: #DFD0B8;

      font-size: 27px;

      margin-bottom: 10px;

      letter-spacing: 1px;
    }

    .profile p {

      color: #948979;

      font-size: 14px;

      line-height: 1.8;

      text-align: center;

      margin-bottom: 25px;
    }

    /* =====================================================
       BUTTON
       ===================================================== */

    .enter {

      text-decoration: none;

      color: #222831;

      background: #DFD0B8;

      padding: 13px 34px;

      border-radius: 30px;

      font-size: 14px;

      font-weight: 700;

      transition:
        background 0.25s ease,
        transform 0.25s ease,
        box-shadow 0.25s ease,
        color 0.25s ease;
    }

    .enter:hover {

      background: #948979;

      color: #DFD0B8;

      transform:
        translateY(-2px);

      box-shadow:
        0 8px 25px
        rgba(148, 137, 121, 0.4);
    }

    /* =====================================================
       SCANLINES
       ===================================================== */

    body::after {

      content: "";

      position: fixed;

      inset: 0;

      z-index: 100;

      pointer-events: none;

      background:
        repeating-linear-gradient(
          to bottom,
          transparent 0px,
          transparent 3px,
          rgba(223, 208, 184, 0.012) 4px
        );
    }

    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 700px) {

      .profile {

        width: 85vw;

        padding: 30px 25px;
      }

      .cat {
        width: 90vw;
      }

      .grid {

        gap: 3px;

        padding: 3px;
      }
    }

  </style>
</head>

<body>

  <!-- HOME PREVIEW -->
  <div class="home-preview" id="homePreview">
    <iframe src="/home" title="Home Preview"></iframe>
  </div>

  <!-- REVEAL -->
  <section class="reveal" id="reveal">
    <img src="/ilustrasi-kucing.png" alt="" class="cat" />
  </section>

  <!-- PROFILE -->
  <div class="profile" id="profile">
    <img
      src="https://images.unsplash.com/photo-1528642474498-1af0c17fd8c3?q=80&w=200&auto=format&fit=crop"
      alt="Profile"
      class="profile-image"
    />
    <h1>Nerr</h1>
    <p>
      Computer Science Student
      <br />
      Active CTF Player
    </p>
    <a href="/home" class="enter" id="enterBtn">Enter Site</a>
  </div>

  <!-- GRID 6 x 6 -->
  <main class="grid" id="grid">
    <!-- ROW 1 -->
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <!-- ROW 2 -->
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <!-- ROW 3 -->
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <!-- ROW 4 -->
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <!-- ROW 5 -->
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <!-- ROW 6 -->
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
    <div class="card"><div class="card-inner"><div class="card-front"></div><div class="card-back"></div></div></div>
  </main>

  <script>
    

    const grid = document.getElementById("grid");
    const reveal = document.getElementById("reveal");
    const profile = document.getElementById("profile");
    const enterBtn = document.getElementById("enterBtn");
    const homePreview = document.getElementById("homePreview");

    let timeoutId = null;

    const cards = Array.from(document.querySelectorAll(".card"));

    function assignRandomGroupDelays() {
      const shuffled = [...cards].sort(() => Math.random() - 0.5);
      
      shuffled.forEach((card, index) => {
        const group = Math.floor(index / 6); 
        const delay = group * 0.05 + (Math.random() * 0.02);
        card.style.setProperty("--delay", `${delay}s`);
      });
    }

    assignRandomGroupDelays();

    /* GRID CLICK */
    grid.addEventListener("click", () => {
      if (grid.dataset.leaving === "true") return;

      if (grid.classList.contains("clicked")) {
        grid.classList.remove("clicked");
        cards.forEach(card => card.classList.remove("card-hidden"));
        reveal.classList.remove("active");
        profile.classList.remove("active");
        clearTimeout(timeoutId);
        return;
      }

      assignRandomGroupDelays();
      grid.classList.add("clicked");

      timeoutId = setTimeout(() => {
        reveal.classList.add("active");
        profile.classList.add("active");
      }, 220);
    });

    /* ENTER SITE */
    enterBtn.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();

      grid.dataset.leaving = "true";

      profile.classList.add("fade-out");
      reveal.classList.remove("active");
      homePreview.classList.add("active");

      // Gunakan delay grouping yang sama, lalu tambahkan kelas card-hidden secara berurutan sesuai delay
      assignRandomGroupDelays();

      cards.forEach(card => {
        const delayStr = card.style.getPropertyValue("--delay");
        const delayMs = parseFloat(delayStr) * 1000;

        setTimeout(() => {
          card.classList.add("card-hidden");
        }, delayMs);
      });

      // Redirect setelah seluruh kartu selesai ber-flip dan menghilang
      setTimeout(() => {
        window.location.href = enterBtn.getAttribute("href");
      }, 850);
    });
  </script>
</body>
</html>