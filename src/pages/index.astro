---
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-6xl">
  <PageHead slot="head" title="Home" />

  <main class="min-h-screen py-10">
    <section class="mb-10">
      <p class="text-muted-foreground mb-3 text-sm">Hi, my name is</p>

      <h1 class="text-5xl font-bold tracking-tight md:text-7xl">
        Jonathan
      </h1>

      <h2 class="mt-3 text-2xl text-muted-foreground md:text-4xl">
        I build web, mobile, and cybersecurity projects.
      </h2>

      <p class="mt-6 max-w-2xl text-muted-foreground">
        Informatics student interested in web development, mobile apps,
        machine learning, computer vision, and CTF cybersecurity.
      </p>
    </section>

    <section class="grid gap-4 md:grid-cols-4">
      <div class="rounded-2xl border bg-card p-6 md:col-span-2 md:row-span-2">
        <p class="text-sm text-muted-foreground">About me</p>
        <h3 class="mt-3 text-2xl font-semibold">Portfolio Bento</h3>
        <p class="mt-4 text-muted-foreground">
          This portfolio contains my projects, blog posts, learning notes,
          and experiments in programming and cybersecurity.
        </p>
      </div>

      <div class="rounded-2xl border bg-card p-6 md:col-span-2">
        <p class="text-sm text-muted-foreground">Current focus</p>
        <h3 class="mt-3 text-xl font-semibold">Cybersecurity & Web Dev</h3>
        <p class="mt-3 text-sm text-muted-foreground">
          Learning CTF, web security, React Native, Astro, and backend development.
        </p>
      </div>

      <a
        href="/blog"
        class="rounded-2xl border bg-card p-6 transition hover:bg-muted md:col-span-1"
      >
        <p class="text-sm text-muted-foreground">Read</p>
        <h3 class="mt-3 text-xl font-semibold">Blog</h3>
      </a>

      <a
        href="/projects"
        class="rounded-2xl border bg-card p-6 transition hover:bg-muted md:col-span-1"
      >
        <p class="text-sm text-muted-foreground">Explore</p>
        <h3 class="mt-3 text-xl font-semibold">Projects</h3>
      </a>

      <div class="rounded-2xl border bg-card p-6 md:col-span-2">
        <p class="text-sm text-muted-foreground">Featured project</p>
        <h3 class="mt-3 text-xl font-semibold">Cakelytics</h3>
        <p class="mt-3 text-sm text-muted-foreground">
          Mobile app for cake business management with product stock,
          sales records, production, and damaged goods tracking.
        </p>
      </div>

      <a
        href="/cv.pdf"
        class="rounded-2xl border bg-card p-6 transition hover:bg-muted md:col-span-2"
      >
        <p class="text-sm text-muted-foreground">Download</p>
        <h3 class="mt-3 text-xl font-semibold">My CV</h3>
      </a>

      <div class="rounded-2xl border bg-card p-6 md:col-span-2">
        <p class="text-sm text-muted-foreground">Tech stack</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-full border px-3 py-1 text-sm">Astro</span>
          <span class="rounded-full border px-3 py-1 text-sm">React Native</span>
          <span class="rounded-full border px-3 py-1 text-sm">Node.js</span>
          <span class="rounded-full border px-3 py-1 text-sm">Prisma</span>
          <span class="rounded-full border px-3 py-1 text-sm">Python</span>
          <span class="rounded-full border px-3 py-1 text-sm">CTF</span>
        </div>
      </div>
    </section>
  </main>
</Layout>